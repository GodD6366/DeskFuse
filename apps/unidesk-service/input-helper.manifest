<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="UniDesk.InputHelper"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- UIAccess is effective only for a signed image installed in a
             trusted location. It permits SendInput/hooks across UIPI while
             retaining the normal user token and does not grant SYSTEM. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="true"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application><supportedOS Id="{8e0f7a12-bb5d-4fe8-b9a5-48fd50a15a9a}"/></application>
  </compatibility>
</assembly>
