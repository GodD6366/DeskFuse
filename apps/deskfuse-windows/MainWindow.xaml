<Window
  x:Class="DeskFuse.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Native Fluent layout: NavigationView-style sidebar, card surfaces,
       and the OS theme colors. Sizing and title are set on AppWindow in code. -->
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="{StaticResource DFTopBarHeight}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top bar: page title on the left, feature controls on the right. -->
    <Grid Grid.Row="0" Margin="24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="PageTitle" Text="设备" Style="{StaticResource DFPageTitleTextStyle}" VerticalAlignment="Center" />
      <ContentControl x:Name="FeatureControlsHost" Grid.Column="1" VerticalAlignment="Center" />
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="{StaticResource DFSidebarWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DFLineBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="12,8,12,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,8,0,8" Spacing="10">
              <FontIcon Glyph="&#xE8A7;" FontSize="24" Foreground="{ThemeResource DFAccentBrush}" />
              <TextBlock Text="DeskFuse" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="在所有设备间，自由流转" Style="{StaticResource DFCaptionTextStyle}" Margin="10,0,0,20" />
            <ListBox x:Name="Navigation" SelectionChanged="NavigationChanged" Background="Transparent" BorderThickness="0">
              <ListBox.Resources>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource DFSidebarRowStyle}">
                  <Setter Property="FontSize" Value="{StaticResource DFBodyFontSize}" />
                </Style>
              </ListBox.Resources>
              <ListBoxItem IsEnabled="False" IsTabStop="False" Content="功能" Style="{StaticResource DFSectionTextStyle}" MinHeight="28" Margin="10,0,0,4" />
              <ListBoxItem Tag="Devices"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE772;" FontSize="16" /><TextBlock Text="设备" /></StackPanel></ListBoxItem>
              <ListBoxItem Tag="Clipboard"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8C8;" FontSize="16" /><TextBlock Text="剪贴板" /></StackPanel></ListBoxItem>
              <ListBoxItem Tag="Input"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE962;" FontSize="16" /><TextBlock Text="键鼠共享" /></StackPanel></ListBoxItem>
              <ListBoxItem Tag="ShareAndTransfer"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8AB;" FontSize="16" /><TextBlock Text="局域网传输" /></StackPanel></ListBoxItem>
              <ListBoxItem IsEnabled="False" IsTabStop="False" Content="进阶" Style="{StaticResource DFSectionTextStyle}" MinHeight="28" Margin="10,12,0,4" />
              <ListBoxItem Tag="RemoteApplications"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8A7;" FontSize="16" /><TextBlock Text="远程应用" /><Border CornerRadius="4" BorderBrush="{ThemeResource DFBorderBrush}" Padding="4,1" Margin="8,0,0,0"><TextBlock Text="Beta" Style="{StaticResource DFCaptionTextStyle}" /></Border></StackPanel></ListBoxItem>
              <ListBoxItem Tag="Microphone"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE720;" FontSize="16" /><TextBlock Text="麦克风共享" /><Border CornerRadius="4" BorderBrush="{ThemeResource DFBorderBrush}" Padding="4,1" Margin="8,0,0,0"><TextBlock Text="Beta" Style="{StaticResource DFCaptionTextStyle}" /></Border></StackPanel></ListBoxItem>
              <ListBoxItem Tag="MouseButtons"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B1;" FontSize="16" /><TextBlock Text="鼠标按键" /><Border CornerRadius="4" BorderBrush="{ThemeResource DFBorderBrush}" Padding="4,1" Margin="8,0,0,0"><TextBlock Text="Beta" Style="{StaticResource DFCaptionTextStyle}" /></Border></StackPanel></ListBoxItem>
            </ListBox>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="8,0,8,0">
            <Border Style="{StaticResource DividerBorder}" Margin="0,0,0,12" />
            <TextBlock x:Name="LocalName" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold" Text="这台 Windows" />
            <TextBlock x:Name="LocalStatus" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="正在连接服务…" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="LocalVersion" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,6,0,8" />
            <Button Content="设置" Click="SettingsClick" HorizontalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,12,0,0" Tapped="HealthTapped">
              <FlyoutBase.AttachedFlyout>
                <Flyout>
                  <StackPanel x:Name="HealthIssuesList" MaxWidth="320" MinWidth="240" Spacing="10" />
                </Flyout>
              </FlyoutBase.AttachedFlyout>
              <Ellipse x:Name="HealthDot" Width="7" Height="7" Fill="{ThemeResource DFSuccessBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="HealthSummary" Text="运行正常" Style="{StaticResource DFCaptionTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Pages -->
      <Grid x:Name="PageHost" Grid.Column="1">
        <ContentControl x:Name="SettingsHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <ContentControl x:Name="RemoteApplicationsPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <Grid x:Name="ClipboardPage">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="280" MaxWidth="380" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Margin="20,12,12,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
              <Button Content="工作流" Click="WorkflowsClick" HorizontalAlignment="Left" />
              <TextBox x:Name="HistorySearch" TextChanged="HistoryFilterChanged" PlaceholderText="搜索剪贴板内容 (Ctrl+F)" />
              <ComboBox x:Name="KindFilter" SelectedIndex="0" SelectionChanged="HistoryFilterChanged">
                <ComboBoxItem Content="全部内容" />
                <ComboBoxItem Content="文字" />
                <ComboBoxItem Content="图片" />
                <ComboBoxItem Content="文件" />
              </ComboBox>
              <ComboBox x:Name="SourceFilter" SelectionChanged="HistoryFilterChanged" PlaceholderText="按来源设备筛选" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
              <Grid>
                <ListBox x:Name="HistoryList" SelectionChanged="HistorySelectionChanged" DoubleTapped="HistoryDoubleClick" Background="Transparent" BorderThickness="0">
                  <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="12,8" />
                      <Setter Property="Margin" Value="2" />
                      <Setter Property="CornerRadius" Value="6" />
                    </Style>
                  </ListBox.Resources>
                  <ListBox.ContextFlyout>
                    <MenuFlyout>
                      <MenuFlyoutItem Text="编辑内容…" Click="EditHistoryContentClick" />
                      <MenuFlyoutItem Text="编辑标题…" Click="EditHistoryTitleClick" />
                      <MenuFlyoutItem Text="删除记录" Click="DeleteHistoryClick" />
                    </MenuFlyout>
                  </ListBox.ContextFlyout>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding SourceName}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CreatedLabel}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="HistoryEmpty" Text="还没有剪贴板记录。&#x0a;复制文字、图片或本机文件开始使用。" Margin="20,30" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
              <CheckBox x:Name="SyncCheck" Content="同步文字与图片" Checked="SyncChanged" Unchecked="SyncChanged" />
              <TextBlock x:Name="SyncStatus" Text="等待服务状态" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
            </StackPanel>
          </Grid>

          <!-- Preview pane -->
          <Grid Grid.Column="1" Margin="12,12,24,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
              <TextBlock x:Name="PreviewTitle" Text="选择一条剪贴板记录" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="PreviewMetadata" Text="选择仅预览；点击复制才恢复系统剪贴板。" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20">
              <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <TextBlock x:Name="TextPreview" Text="内容将在这里显示" FontSize="{StaticResource SubtitleFontSize}" IsTextSelectionEnabled="True" />
                </ScrollViewer>
                <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="复制" Style="{StaticResource AccentButtonStyle}" Click="CopyClick" IsEnabled="False" />
                <Button x:Name="AddShelfButton" Content="加入暂存区" Click="AddShelfClick" IsEnabled="False" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="EditContentButton" Content="编辑内容" Click="EditHistoryContentClick" IsEnabled="False" />
                <Button x:Name="EditTitleButton" Content="编辑标题" Click="EditHistoryTitleClick" IsEnabled="False" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="RevealButton" Content="在资源管理器中显示" Click="RevealClick" Visibility="Collapsed" />
                <Button x:Name="FitButton" Content="适合窗口 / 填满" Click="FitClick" Visibility="Collapsed" Margin="0,0,0,8" />
              </StackPanel>
              <TextBlock x:Name="FormatMetadata" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- Input sharing -->
        <Grid x:Name="InputPage" Visibility="Collapsed" Margin="24,12,24,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,20,0">
              <Grid>
                <Canvas x:Name="DisplayCanvas" SizeChanged="DisplayCanvasSizeChanged" />
                <TextBlock Text="本机显示器（物理像素）；主控可拖动远端显示器，位置由输入运行时持久化。" VerticalAlignment="Bottom" Margin="20" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Windows 输入状态" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold" />
                  <TextBlock x:Name="InputAvailability" Text="正在连接普通桌面输入 helper…" Margin="0,12,0,16" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <CheckBox x:Name="InputReceiverReady" Content="允许已授权主控控制当前普通桌面" IsEnabled="False" />
                  <Button x:Name="ReclaimInputButton" Content="停止被控并收回本机输入" Click="ReclaimInputClick" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0" />
                  <Border Style="{StaticResource DividerBorder}" />
                  <TextBlock Text="共享快捷键（key code / 修饰键）" FontWeight="SemiBold" />
                  <TextBlock Text="每行对应左、右、上、下、锁定；修改后由 Rust 输入运行时校验并持久化。" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,8" />
                  <TextBox x:Name="ShortcutBindings" AcceptsReturn="True" Height="120" FontFamily="Cascadia Mono" />
                  <Button Content="保存快捷键" Click="SaveShortcutBindingsClick" HorizontalAlignment="Left" />
                  <Border Style="{StaticResource DividerBorder}" />
                  <TextBlock Text="流畅度" FontWeight="SemiBold" />
                  <TextBlock x:Name="InputQualitySummary" Text="等待输入" TextWrapping="Wrap" />
                  <TextBlock x:Name="InputQualityMetrics" Text="P50 — · P95 — · 卡顿 —" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock x:Name="InputQualityMode" Text="等待会话" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock x:Name="InputQualityAdvice" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <Canvas x:Name="InputQualityCanvas" Height="72" Margin="0,8,0,0" />
                  <Border Style="{StaticResource DividerBorder}" />
                  <TextBlock Text="布局与 Wi-Fi" FontWeight="SemiBold" />
                  <TextBlock x:Name="WifiEnvironmentText" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <Button x:Name="SaveEnvironmentLayoutButton" Content="保存布局到当前 Wi-Fi" Click="SaveEnvironmentLayoutClick" HorizontalAlignment="Left" Margin="0,8,0,4" />
                  <StackPanel x:Name="LayoutScenesPanel" Margin="0,4,0,0" />
                  <Border Style="{StaticResource DividerBorder}" />
                  <TextBlock Text="当前阶段支持已解锁普通桌面；管理员窗口、登录与 UAC 安全桌面仍保持不可用。紧急收回：Ctrl + Alt + Win + Esc。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>

        <!-- Devices -->
        <Grid x:Name="DevicesPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Margin="20,12,12,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
              <TextBox x:Name="DeviceSearch" PlaceholderText="搜索设备" TextChanged="DeviceSearchChanged" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
              <ListBox x:Name="DevicesList" SelectionChanged="DeviceSelectionChanged" Background="Transparent" BorderThickness="0">
                <ListBox.Resources>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="CornerRadius" Value="6" />
                  </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Group}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,4,0,0" />
                      <TextBlock Text="{Binding Detail}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="通过 IPv4 添加设备" FontWeight="SemiBold" />
                <TextBlock Text="只定位对端；仍需接收方确认配对。" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,10" />
                <TextBox x:Name="ManualIp" PlaceholderText="例如 192.168.1.23" />
                <Button x:Name="PairIpButton" Content="定位并邀请配对" Click="PairIpClick" HorizontalAlignment="Left" Margin="0,0,0,0" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="12,12,24,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="DeviceDetails" />
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- Transfers -->
        <ScrollViewer x:Name="TransfersPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <Grid Margin="24,12,24,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="380" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="共享与发送" Style="{StaticResource DFSectionTextStyle}" />
                <TextBlock Text="在设备之间发送文件：拖入暂存区或从剪贴板发送；远端文件按需传输，接收的文件经过完整校验后落盘，并放入本机剪贴板。" Style="{StaticResource DFDetailTextStyle}" Margin="0,8,0,12" />
                <Button Content="打开本地暂存区" Click="ShelfClick" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="传输任务" Style="{StaticResource DFSectionTextStyle}" />
                <TextBlock x:Name="TransferSummary" Style="{StaticResource DFDetailTextStyle}" Margin="0,8,0,4" Text="等待服务状态…" />
                <StackPanel x:Name="TransferList" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>

        <!-- Workflows -->
        <Grid x:Name="WorkflowsPage" Visibility="Collapsed" Margin="24,12,24,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Margin="0,0,20,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
              <TextBlock Text="工作流" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
              <TextBlock Text="管理内容处理步骤和工作流快捷键" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,16" />
              <Button Content="新建工作流" Click="NewWorkflowClick" HorizontalAlignment="Left" Margin="0,0,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
              <ListBox x:Name="WorkflowList" SelectionChanged="WorkflowSelectionChanged" Background="Transparent" BorderThickness="0">
                <ListBox.Resources>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="CornerRadius" Value="6" />
                  </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ShortcutLabel}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
          <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="WorkflowEditor">
                <TextBlock Text="选择或新建工作流" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold" />
                <TextBlock Text="快捷键与步骤由服务端 Rust 模型校验；保存后写入服务数据库。" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,18" />
                <TextBlock Text="名称" FontWeight="SemiBold" />
                <TextBox x:Name="WorkflowName" Margin="0,6,0,14" />
                <CheckBox x:Name="WorkflowEnabled" Content="启用本机快捷键" Margin="0,0,0,14" />
                <TextBlock Text="快捷键（key code, modifiers；留空表示无快捷键）" FontWeight="SemiBold" />
                <TextBox x:Name="WorkflowShortcut" Margin="0,6,0,14" PlaceholderText="例如 49,1835008" />
                <TextBlock Text="步骤" FontWeight="SemiBold" />
                <TextBlock Text="快捷键会通过受认证 IPC 调度到 Windows 服务；服务按 capability 检查并拒绝未支持的图片、文件或系统快捷指令步骤。" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="SaveWorkflowButton" Content="保存" Click="SaveWorkflowClick" />
                  <Button x:Name="DeleteWorkflowButton" Content="删除" Click="DeleteWorkflowClick" />
                </StackPanel>
                <TextBlock x:Name="WorkflowNotice" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <!-- Microphone sharing (Beta placeholder) -->
        <Grid x:Name="MicrophonePage" Visibility="Collapsed" Margin="24,12,24,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource CardBorder}" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Spacing="8">
              <FontIcon Glyph="&#xE720;" FontSize="40" Foreground="{ThemeResource DFMutedBrush}" />
              <TextBlock Text="麦克风共享" Style="{StaticResource DFPageTitleTextStyle}" HorizontalAlignment="Center" />
              <TextBlock Text="跨设备共享麦克风即将在 Windows 上提供。" Style="{StaticResource DFDetailTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Mouse buttons (Beta placeholder) -->
        <Grid x:Name="MouseButtonsPage" Visibility="Collapsed" Margin="24,12,24,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource CardBorder}" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Spacing="8">
              <FontIcon Glyph="&#xE8B1;" FontSize="40" Foreground="{ThemeResource DFMutedBrush}" />
              <TextBlock Text="鼠标按键" Style="{StaticResource DFPageTitleTextStyle}" HorizontalAlignment="Center" />
              <TextBlock Text="侧键自定义即将在 Windows 上提供。" Style="{StaticResource DFDetailTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <!-- Floating notice, mirrored from the macOS error banner: bottom-right,
         persistent until replaced, hairline card surface. -->
    <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,24" MaxWidth="480" Background="{ThemeResource DFSurfaceBrush}" BorderBrush="{ThemeResource DFLineBrush}" BorderThickness="1" CornerRadius="{StaticResource DFRadiusCard}" Padding="12,10">
      <TextBlock x:Name="Notice" Text="正在连接 DeskFuseService…" Style="{StaticResource DFCaptionTextStyle}" TextWrapping="Wrap" />
    </Border>

    <!-- First-run onboarding: covers the workspace until completed. -->
    <Grid x:Name="OnboardingOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{ThemeResource DFCanvasBrush}">
      <ContentControl x:Name="OnboardingHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
  </Grid>
</Window>
