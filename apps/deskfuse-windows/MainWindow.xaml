<Window
  x:Class="DeskFuse.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:DeskFuse.Windows">
  <!-- Shell mirrored from the macOS MainSidebar/RootView: a 212 pt sidebar
       with the brand inside the hidden titlebar row, grouped navigation, the
       settings category rail and the health footer. The workspace uses the
       52 pt breadcrumb header and the canvas palette. -->
  <Grid x:Name="Root" Background="{ThemeResource DFCanvasBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="{StaticResource DFTopBarHeight}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource DFSidebarWidth}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Drag region sits behind the titlebar content. Window caption buttons
         stay on the right, so the breadcrumb row keeps a 150 pt inset. -->
    <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent" />

    <!-- Sidebar titlebar row: mac traffic lights at x=20 and the brand at x=92. -->
    <Grid Grid.Row="0" Grid.Column="0" Padding="20,0,16,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="CloseLight" Style="{StaticResource DFTrafficLightStyle}"
                Click="CloseLightClick" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited"
                ToolTipService.ToolTip="关闭" AutomationProperties.Name="关闭"
                AutomationProperties.AutomationId="traffic-close">
          <Grid Width="12" Height="12">
            <Ellipse Fill="#FF5F57" />
            <TextBlock Text="&#x2715;" FontSize="8" Foreground="#FF7A0000"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
        </Button>
        <Button x:Name="MinimizeLight" Style="{StaticResource DFTrafficLightStyle}"
                Click="MinimizeLightClick" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited"
                ToolTipService.ToolTip="最小化" AutomationProperties.Name="最小化"
                AutomationProperties.AutomationId="traffic-minimize">
          <Grid Width="12" Height="12">
            <Ellipse Fill="#FEBC2E" />
            <TextBlock Text="&#x2212;" FontSize="9" Foreground="#FF6A4B00"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
        </Button>
        <Button x:Name="MaximizeLight" Style="{StaticResource DFTrafficLightStyle}"
                Click="MaximizeLightClick" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited"
                ToolTipService.ToolTip="最大化" AutomationProperties.Name="最大化"
                AutomationProperties.AutomationId="traffic-maximize">
          <Grid Width="12" Height="12">
            <Ellipse Fill="#28C840" />
            <TextBlock Text="&#x271A;" FontSize="8" Foreground="#FF0B4A16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0,0,0">
          <Grid Width="22" Height="22">
            <Image x:Name="BrandMarkImage" Stretch="Uniform" />
          </Grid>
          <TextBlock Text="DeskFuse" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Workspace titlebar row: section / page breadcrumb + feature switch. -->
    <Grid Grid.Row="0" Grid.Column="1" Padding="24,0,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock x:Name="SectionLabel" Text="配置" FontSize="13" Foreground="{ThemeResource DFMutedBrush}" />
        <TextBlock Text="/" FontSize="13" Foreground="{ThemeResource DFMutedBrush}" />
        <TextBlock x:Name="PageTitle" Text="设备" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
        <Border x:Name="PageBadge" Visibility="Collapsed" Background="{ThemeResource DFWarningSubtleBrush}"
                CornerRadius="4" Padding="6,1" Margin="2,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="即将支持" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource DFWarningBrush}" />
        </Border>
      </StackPanel>
      <Grid x:Name="FeatureControlsHost" Grid.Column="1" VerticalAlignment="Center" />
    </Grid>

    <!-- Sidebar body -->
    <Grid Grid.Row="1" Grid.Column="0" Background="{ThemeResource DFCanvasBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="NavPanel" Margin="8,4,8,4" Spacing="1" />
      </ScrollViewer>

      <StackPanel Grid.Row="1" Margin="8,0,8,8">
        <Border Height="1" Background="{ThemeResource DFLineBrush}" Margin="0,0,0,8" />
        <Button x:Name="SettingsButton" Style="{StaticResource DFNavButtonStyle}" Click="SettingsClick"
                AutomationProperties.Name="设置" AutomationProperties.AutomationId="settings-open">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <FontIcon x:Name="SettingsIcon" Glyph="&#xE713;" FontSize="14"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="18" />
            <TextBlock Text="设置" FontSize="13" />
          </StackPanel>
        </Button>
        <StackPanel x:Name="SettingsCategories" Margin="16,2,0,4" Visibility="Collapsed">
          <Border HorizontalAlignment="Left" Width="1" Background="{ThemeResource DFLineBrush}"
                  Margin="-8,4,0,4" />
        </StackPanel>
        <Button x:Name="HealthButton" Style="{StaticResource DFNavButtonStyle}" Padding="12,8"
                HorizontalContentAlignment="Stretch" Click="HealthClick" AutomationProperties.Name="运行状态">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="HealthDot" Width="7" Height="7" Fill="{ThemeResource DFSuccessBrush}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="HealthSummary" Grid.Column="1" Text="一切正常" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <FontIcon x:Name="HealthChevron" Grid.Column="2" Glyph="&#xE76C;" FontSize="10"
                      Foreground="{ThemeResource DFMutedBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </StackPanel>
      <Border Width="1" HorizontalAlignment="Right" Background="{ThemeResource DFLineBrush}" />
    </Grid>

    <!-- Workspace -->
    <Grid x:Name="PageHost" Grid.Row="1" Grid.Column="1" Background="{ThemeResource DFCanvasBrush}">
      <Grid x:Name="SettingsHost" Visibility="Collapsed" />

      <!-- Devices -->
      <Grid x:Name="DevicesPage" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="20,18,20,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
              <TextBlock Text="设备列表" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="发现并管理附近设备" FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
              <Button x:Name="ManualPairButton" Style="{StaticResource DFIconButtonStyle}" Click="ManualPairClick"
                      ToolTipService.ToolTip="手动输入 IPv4 地址">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
              </Button>
              <Button Style="{StaticResource DFIconButtonStyle}" Click="RefreshDevicesClick"
                      ToolTipService.ToolTip="刷新设备">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
              </Button>
              <Button Style="{StaticResource DFIconButtonStyle}" IsEnabled="False"
                      ToolTipService.ToolTip="批量触发设备更新（服务尚未提供）">
                <FontIcon Glyph="&#xE896;" FontSize="13" />
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Margin="20,0,20,10" Height="32" CornerRadius="8"
                  Background="{ThemeResource DFControlBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE721;" FontSize="13" Margin="10,0,8,0" VerticalAlignment="Center"
                        Foreground="{ThemeResource DFMutedBrush}" />
              <TextBox x:Name="DeviceSearch" Grid.Column="1" PlaceholderText="搜索设备名称、IP 地址…"
                       TextChanged="DeviceSearchChanged" BorderThickness="0" Background="Transparent"
                       Padding="0,0,8,0" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <StackPanel x:Name="PairingHost" Grid.Row="2" Margin="18,0,18,8" Spacing="8" />

          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="8,0,8,16">
            <StackPanel x:Name="DevicesList" Spacing="1" />
          </ScrollViewer>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="DeviceDetails" Margin="24,4,24,24" Spacing="14" />
        </ScrollViewer>
        <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="{ThemeResource DFLineBrush}" />
      </Grid>

      <!-- Clipboard -->
      <Grid x:Name="ClipboardPage">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="196" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="340" MinWidth="280" MaxWidth="380" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 分组与列表：剪贴板页自己的内容导航 -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="分组与列表" FontSize="15" FontWeight="SemiBold" Margin="20,0"
                     VerticalAlignment="Center" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LibraryListPanel" Margin="10,0,10,8" Spacing="4" />
          </ScrollViewer>
          <Border Grid.Row="2" Padding="12,6,12,12">
            <Button Style="{StaticResource DFNavButtonStyle}" Click="WorkflowsClick"
                    AutomationProperties.Name="工作流">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource DFMutedBrush}"
                          HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="工作流" FontSize="13" Margin="9,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="WorkflowCountLabel" Grid.Column="2" FontSize="11"
                           Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="10"
                          Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </Border>
        </Grid>
        <Border Grid.Column="1" Width="1" Background="{ThemeResource DFLineBrush}" />

        <Grid Grid.Column="2" Background="{ThemeResource DFSurfaceBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Margin="20,14,16,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="历史记录" FontSize="14" FontWeight="SemiBold" />
              <TextBlock x:Name="HistoryCount" FontSize="11" Foreground="{ThemeResource DFMutedBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button x:Name="BulkDeleteButton" Content="删除所选" Click="DeleteSelectedClick"
                      Style="{StaticResource DFButtonSecondaryStyle}" MinHeight="26" FontSize="11"
                      Padding="8,0" Visibility="Collapsed" Margin="0" />
              <Button Style="{StaticResource DFIconButtonStyle}" Click="HistoryMenuClick"
                      ToolTipService.ToolTip="更多操作">
                <FontIcon Glyph="&#xE712;" FontSize="13" />
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Margin="20,0,20,10" Height="40" CornerRadius="8"
                  Background="{ThemeResource DFControlBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE721;" FontSize="13" Margin="12,0,8,0" VerticalAlignment="Center"
                        Foreground="{ThemeResource DFMutedBrush}" />
              <TextBox x:Name="HistorySearch" Grid.Column="1" PlaceholderText="搜索剪贴板"
                       TextChanged="HistoryFilterChanged" BorderThickness="0" Background="Transparent"
                       Padding="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="Ctrl F" FontSize="11" Margin="0,0,12,0"
                         Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center"
                         IsHitTestVisible="False" />
            </Grid>
          </Border>

          <!-- 来源筛选（左）+ 显示模式切换（右），与 mac 对齐 -->
          <Grid Grid.Row="2" Margin="20,0,16,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SourceFilterButton" Click="SourceFilterClick"
                    MinHeight="28" Padding="8,0" Margin="0"
                    CornerRadius="6" Template="{StaticResource DFFlatButtonTemplate}"
                    Background="Transparent" BorderThickness="0">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE7F8;" FontSize="13" Foreground="{ThemeResource DFMutedBrush}" />
                <TextBlock x:Name="SourceFilterLabel" Text="所有设备" FontSize="12"
                           Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource DFMutedBrush}" />
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button x:Name="DisplayModeListButton" Click="DisplayModeListClick"
                      ToolTipService.ToolTip="列表视图" MinHeight="28" MinWidth="32" Padding="6,0"
                      CornerRadius="6" Template="{StaticResource DFFlatButtonTemplate}"
                      Background="{ThemeResource DFControlBrush}" BorderThickness="0">
                <FontIcon Glyph="&#xE8FD;" FontSize="13" />
              </Button>
              <Button x:Name="DisplayModeGridButton" Click="DisplayModeGridClick"
                      ToolTipService.ToolTip="网格视图" MinHeight="28" MinWidth="32" Padding="6,0"
                      CornerRadius="6" Template="{StaticResource DFFlatButtonTemplate}"
                      Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE80A;" FontSize="13" />
              </Button>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="3">
            <!-- 列表模式 -->
            <ListView x:Name="HistoryList" SelectionChanged="HistorySelectionChanged"
                      ContainerContentChanging="HistoryContainerChanging"
                      DoubleTapped="HistoryDoubleClick" Background="Transparent" BorderThickness="0"
                      Padding="8,0,8,8" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,1" />
                  <Setter Property="MinHeight" Value="52" />
                  <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}" />
                  <Setter Property="CornerRadius" Value="8" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ContextFlyout>
                <MenuFlyout Opening="HistoryContextOpening">
                  <MenuFlyoutItem Text="复制" Click="CopyClick" />
                  <MenuFlyoutItem Text="编辑标题…" Click="EditHistoryTitleClick" />
                  <MenuFlyoutItem Text="编辑内容…" Click="EditHistoryContentClick" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem x:Name="SaveImageContextMenuItem" Text="保存图片…" Click="SaveImageClick" />
                  <MenuFlyoutItem x:Name="SaveTextContextMenuItem" Text="保存文本…" Click="SaveTextClick" />
                  <MenuFlyoutItem x:Name="SaveFilesContextMenuItem" Text="保存文件…" Click="SaveFilesClick" />
                  <MenuFlyoutItem x:Name="OpenFileContextMenuItem" Text="打开文件" Click="OpenFileClick" />
                  <MenuFlyoutItem x:Name="RevealContextMenuItem" Text="在资源管理器中显示" Click="RevealClick" />
                  <MenuFlyoutItem Text="加入暂存区" Click="AddShelfClick" />
                  <MenuFlyoutSubItem x:Name="ShareToDeviceMenu" Text="发送到设备" />
                  <MenuFlyoutSubItem x:Name="WorkflowHistoryMenu" Text="使用工作流" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutSubItem x:Name="AddToListContextMenu" Text="添加到列表" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="删除记录" Click="DeleteHistoryClick" />
                </MenuFlyout>
              </ListView.ContextFlyout>
              <ListView.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Key}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{ThemeResource DFMutedBrush}" Margin="10,12,0,4" />
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListView.GroupStyle>
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Padding="8,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="8" Background="{ThemeResource DFControlBrush}">
                      <local:ClipboardThumbnail Entry="{Binding}" Loaded="HistoryThumbnailLoaded" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                                 Foreground="{ThemeResource DFMutedBrush}" TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" FontSize="12"
                               Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <!-- Both modes retain their scroll position; only the viewport is realized. -->
            <ScrollViewer x:Name="HistoryGrid" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          Padding="12,0,12,12" ViewChanged="HistoryGridViewChanged">
              <ItemsRepeater x:Name="HistoryCards" ElementPrepared="HistoryCardPrepared"
                             ElementClearing="HistoryCardClearing">
                <ItemsRepeater.Layout>
                  <local:ClipboardMasonryLayout />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate>
                    <Border Loaded="HistoryCardLoaded" Tapped="HistoryCardTapped" Background="{ThemeResource DFCanvasBrush}"
                            BorderBrush="{ThemeResource DFLineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12" MinHeight="112">
                      <StackPanel Spacing="6">
                        <local:ClipboardThumbnail Entry="{Binding}" Height="140"
                                                  Loaded="HistoryThumbnailLoaded" />
                        <TextBlock Text="{Binding Title}" FontSize="13" MaxLines="4"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        <Grid ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding TimeLabel}" FontSize="11" Foreground="{ThemeResource DFMutedBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding SourceName}" FontSize="11"
                                     TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                     Foreground="{ThemeResource DFMutedBrush}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </ScrollViewer>

            <StackPanel x:Name="HistoryEmpty" Margin="24,40" Spacing="8" HorizontalAlignment="Center"
                        IsHitTestVisible="False">
              <FontIcon Glyph="&#xE8C8;" FontSize="24" Foreground="{ThemeResource DFMutedBrush}"
                        HorizontalAlignment="Center" />
              <TextBlock x:Name="HistoryEmptyTitle" Text="还没有剪贴板历史" FontSize="12" FontWeight="Medium"
                         TextAlignment="Center" HorizontalAlignment="Center" />
              <TextBlock x:Name="HistoryEmptyDetail" Text="复制文字、图片或文件后&#x0a;会显示在这里。"
                         FontSize="11" Foreground="{ThemeResource DFMutedBrush}" TextAlignment="Center"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="4" Margin="20,8,20,14" Spacing="4" Visibility="Collapsed">
            <CheckBox x:Name="SyncCheck" Content="跨设备同步" Checked="SyncChanged" Unchecked="SyncChanged" />
            <TextBlock x:Name="SyncStatus" Text="等待服务状态" FontSize="11"
                       Foreground="{ThemeResource DFMutedBrush}" />
          </StackPanel>
        </Grid>

        <Grid Grid.Column="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- header: 小字 metadata 在上，大标题在下（mac 排版） -->
          <StackPanel Margin="24,18,24,14" Spacing="6">
            <TextBlock x:Name="PreviewMetadata" Text="在任意应用里复制，内容会在可信设备之间同步。"
                       FontSize="12" Foreground="{ThemeResource DFMutedBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewTitle" Visibility="Collapsed" FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto">
            <Grid>
              <TextBlock x:Name="TextPreview" Text="内容将在这里显示" FontSize="15" IsTextSelectionEnabled="True"
                         TextWrapping="Wrap" LineHeight="22" />
              <Border x:Name="ImagePreviewHost" CornerRadius="12" Background="{ThemeResource DFControlBrush}"
                      Visibility="Collapsed" Margin="0,0,0,0" Padding="8">
                <Image x:Name="ImagePreview" Stretch="Uniform" MaxHeight="440" HorizontalAlignment="Center" />
              </Border>
              <StackPanel x:Name="PreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="8" MaxWidth="360" IsHitTestVisible="False">
                <FontIcon Glyph="&#xE8C8;" FontSize="40" Foreground="{ThemeResource DFMutedBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="复制内容，从这里接着用" FontSize="15" FontWeight="SemiBold"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock Text="在任意应用里复制，按 Ctrl+F 可以搜索；内容会在可信设备之间同步。"
                           FontSize="12" Foreground="{ThemeResource DFMutedBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <!-- metadataCard 上方分隔线 -->
          <Border Grid.Row="2" Height="1" Background="{ThemeResource DFLineBrush}" Margin="24,0,24,0" />

          <!-- metadataCard：mac 的卡片化元数据 -->
          <Border x:Name="MetadataCard" Grid.Row="3" Margin="24,12,24,0"
                  Background="{ThemeResource DFSurfaceBrush}" BorderBrush="{ThemeResource DFLineBrush}"
                  BorderThickness="1" CornerRadius="12" Padding="16,12" Visibility="Collapsed">
            <StackPanel Spacing="6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="种类" FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
                <TextBlock x:Name="MetaKind" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="大小" FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
                <TextBlock x:Name="MetaSize" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="来源设备" FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
                <TextBlock x:Name="MetaSource" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="添加时间" FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
                <TextBlock x:Name="MetaTime" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid x:Name="MetaOcrRow" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="图片文字" FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
                <TextBlock x:Name="MetaOcr" Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                           MaxLines="4" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 操作行：右对齐 [加入暂存区] [复制] [⋯] -->
          <Grid Grid.Row="4" Margin="24,12,24,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button x:Name="RevealButton" Content="在资源管理器中显示" Click="RevealClick"
                      Style="{StaticResource DFButtonSecondaryStyle}" Visibility="Collapsed" />
              <Button x:Name="FitButton" Content="适合窗口 / 填满" Click="FitClick"
                      Style="{StaticResource DFButtonSecondaryStyle}" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button x:Name="AddShelfButton" Content="加入暂存区" Click="AddShelfClick"
                      Style="{StaticResource DFButtonSecondaryStyle}" IsEnabled="False" />
              <Button x:Name="CopyButton" Content="复制" Click="CopyClick"
                      Style="{StaticResource DFButtonPrimaryStyle}" IsEnabled="False" />
              <DropDownButton x:Name="MoreActionsButton" Style="{StaticResource DFButtonSecondaryStyle}"
                              MinWidth="32" Padding="8,0" IsEnabled="False">
                <FontIcon Glyph="&#xE712;" FontSize="13" />
                <DropDownButton.Flyout>
                  <MenuFlyout Opening="HistoryContextOpening">
                    <MenuFlyoutItem x:Name="EditTitleMenuItem" Text="编辑标题…" Click="EditHistoryTitleClick" />
                    <MenuFlyoutItem x:Name="EditContentMenuItem" Text="编辑内容…" Click="EditHistoryContentClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="SaveImageMenuItem" Text="保存图片…" Click="SaveImageClick" />
                    <MenuFlyoutItem x:Name="SaveTextMenuItem" Text="保存文本…" Click="SaveTextClick" />
                    <MenuFlyoutItem x:Name="SaveFilesMenuItem" Text="保存文件…" Click="SaveFilesClick" />
                    <MenuFlyoutItem x:Name="OpenFileMenuItem" Text="打开文件" Click="OpenFileClick" />
                    <MenuFlyoutSubItem x:Name="WorkflowHistoryMenuCompact" Text="使用工作流" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem x:Name="AddToListMenu" Text="添加到列表" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="DeleteMenuItem" Text="删除记录" Click="DeleteHistoryClick" />
                  </MenuFlyout>
                </DropDownButton.Flyout>
              </DropDownButton>
            </StackPanel>
          </Grid>
        </Grid>
        <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="{ThemeResource DFLineBrush}" />
      </Grid>

      <!-- Input sharing -->
      <!-- Input -->
      <ScrollViewer x:Name="InputPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                    SizeChanged="InputPageSizeChanged">
        <Grid x:Name="InputContent" Margin="24,4,24,24" RowSpacing="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- 页头：标题在左；右侧依次为主控开关、Wi-Fi 标识胶囊、添加设备 -->
          <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="当前屏幕排布" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock x:Name="InputFeatureLabel" Text="此电脑作为主控" FontSize="12" FontWeight="Medium"
                         VerticalAlignment="Center" />
              <Grid x:Name="InputControllerToggleHost" VerticalAlignment="Center" />
              <Button x:Name="WifiIdentityButton" Click="WifiIdentityClick" Height="24" MinHeight="0" MinWidth="0"
                      Padding="10,0" Margin="0" Background="{ThemeResource DFControlBrush}" BorderThickness="0"
                      CornerRadius="12" Template="{StaticResource DFFlatButtonTemplate}" VerticalAlignment="Center"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTipService.ToolTip="查看 Wi-Fi 标识详情"
                      AutomationProperties.Name="Wi-Fi 标识" AutomationProperties.AutomationId="input-wifi-identity">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon x:Name="WifiIdentityGlyph" Glyph="&#xE701;" FontSize="12"
                            Foreground="{ThemeResource DFMutedBrush}" />
                  <TextBlock x:Name="WifiIdentitySummary" Text="未连接 Wi-Fi" FontSize="12" FontWeight="Medium"
                             MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <FontIcon x:Name="WifiIdentityWarning" Glyph="&#xE7BA;" FontSize="11"
                            Foreground="{ThemeResource DFWarningBrush}" Visibility="Collapsed"
                            VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Click="AddInputDeviceClick" Style="{StaticResource DFButtonPrimaryStyle}" Margin="0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE710;" FontSize="12" />
                  <TextBlock Text="添加设备" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- 排布卡片吃掉页头以下的全部高度；窗口过矮时保留最小高度并允许滚动。 -->
          <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                  <TextBlock x:Name="InputLayoutSummary" Text="0 个屏幕" FontSize="12" FontWeight="Medium"
                             Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center" />
                  <Button x:Name="QualityBadge" Click="QualityBadgeClick" Visibility="Collapsed" MinHeight="0"
                          MinWidth="0" Padding="10,5" Margin="0" Background="{ThemeResource DFControlBrush}"
                          BorderThickness="0" CornerRadius="16" Template="{StaticResource DFFlatButtonTemplate}"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          ToolTipService.ToolTip="流畅度：最近 60 秒往返延迟趋势，点击查看详情"
                          AutomationProperties.Name="流畅度详情" AutomationProperties.AutomationId="input-quality-badge">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Canvas x:Name="QualityBadgeCanvas" Width="72" Height="22" />
                      <TextBlock x:Name="QualityBadgeLatency" Text="—" FontSize="11" FontWeight="SemiBold"
                                 FontFamily="Cascadia Mono" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Ellipse x:Name="QualityBadgeDot" Width="6" Height="6"
                                 Fill="{ThemeResource DFMutedBrush}" />
                        <TextBlock x:Name="QualityBadgeStatus" Text="空闲" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource DFMutedBrush}" />
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock Grid.Column="1" Text="拖动屏幕以匹配实际摆放位置" FontSize="11"
                           Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center" />
              </Grid>
              <Border Grid.Row="1" CornerRadius="12" Background="{ThemeResource DFControlBrush}"
                      Margin="8,0,8,8">
                <Canvas x:Name="DisplayCanvas" SizeChanged="DisplayCanvasSizeChanged" />
              </Border>
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock x:Name="InputAvailability" FontSize="12" Foreground="{ThemeResource DFMutedBrush}" TextWrapping="Wrap" />
            <Button x:Name="ReclaimInputButton" Content="停止被控" Click="ReclaimInputClick"
                    Style="{StaticResource DFButtonSecondaryStyle}" Visibility="Collapsed" HorizontalAlignment="Left" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- Transfers -->
      <Grid x:Name="TransfersPage" Visibility="Collapsed" SizeChanged="TransfersPageSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="TransfersLeftColumn" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" SizeChanged="TransfersLeftSizeChanged">
          <Grid x:Name="TransfersLeftContent" Margin="16" RowSpacing="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 手机扫码 -->
            <StackPanel Spacing="8">
              <TextBlock Text="手机扫码传输" FontSize="13" FontWeight="SemiBold"
                         Foreground="{ThemeResource DFMutedBrush}" Margin="4,0,0,0" />
              <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="允许局域网访问" FontSize="13" FontWeight="Medium" />
                      <TextBlock Text="同一局域网内的手机扫码即可发送照片或文字。"
                                 FontSize="12" Foreground="{ThemeResource DFMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid x:Name="LanAccessToggleHost" Grid.Column="1" VerticalAlignment="Center" />
                  </Grid>
                  <Border Height="1" Background="{ThemeResource DFLineBrush}" Margin="0,12" />
                  <StackPanel x:Name="LanWebContent" Spacing="12" HorizontalAlignment="Center" Margin="0,8" />
                </StackPanel>
              </Border>
              <TextBlock Text="离开此页仍保持可用；重启后自动恢复上次的开关。" FontSize="12"
                         Foreground="{ThemeResource DFMutedBrush}" Margin="4,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 发送区：拖放面板撑满左栏剩余高度 -->
            <Grid Grid.Row="1" RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="发送文件" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource DFMutedBrush}" Margin="4,0,0,0" VerticalAlignment="Bottom" />
                <TextBlock Grid.Column="1" Text="也可从托盘图标打开暂存区" FontSize="11"
                           Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Bottom" />
              </Grid>
              <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <!-- 拖放目标：空态时整块虚线区域可点击选择；有文件时显示列表 -->
                  <Grid x:Name="FileDropSurface" Margin="12" AllowDrop="True" DragOver="FileDropDragOver"
                        Drop="FileDropDrop" DragLeave="FileDropDragLeave">
                    <Grid x:Name="DropZoneEmpty">
                      <Rectangle x:Name="DropZoneRect" RadiusX="12" RadiusY="12"
                                 Fill="{ThemeResource DFControlBrush}" Stroke="{ThemeResource DFLineBrush}"
                                 StrokeThickness="1" StrokeDashArray="6 4" />
                      <Button Click="PickFilesClick" Background="Transparent" BorderThickness="0" Padding="0"
                              Margin="0" Template="{StaticResource DFFlatButtonTemplate}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              ToolTipService.ToolTip="选择要发送的文件">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                          <FontIcon Glyph="&#xE898;" FontSize="28" Foreground="{ThemeResource DFMutedBrush}"
                                    HorizontalAlignment="Center" />
                          <TextBlock x:Name="DropZoneTitle" Text="拖入文件或文件夹" FontSize="13"
                                     FontWeight="Medium" TextAlignment="Center" />
                          <TextBlock Text="或点击选择 · 只会发送给下方选中的在线电脑" FontSize="12"
                                     Foreground="{ThemeResource DFMutedBrush}" TextAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Grid>
                    <Grid x:Name="StagedListHost" Visibility="Collapsed">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StagedHeaderText" Text="0 个项目" FontSize="13" FontWeight="Medium"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                          <Button Click="PickFilesClick" Style="{StaticResource DFButtonPlainStyle}" Margin="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <FontIcon Glyph="&#xE710;" FontSize="11" />
                              <TextBlock Text="添加" />
                            </StackPanel>
                          </Button>
                          <Button Content="清空" Click="ClearStagedClick" Style="{StaticResource DFButtonPlainStyle}"
                                  Margin="0" />
                        </StackPanel>
                      </Grid>
                      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StagedFilesPanel" Spacing="0" />
                      </ScrollViewer>
                    </Grid>
                  </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="12,0,12,8">
                      <Button Content="选择文件夹…" Click="PickFolderClick" Style="{StaticResource DFButtonPlainStyle}" />
                    </StackPanel>

                  <!-- 底栏：目标电脑在左，操作在右 -->
                  <Grid Grid.Row="2" Margin="16,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock x:Name="SendTargetLabel" Text="发送到" FontSize="12"
                                 Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center" />
                      <ComboBox x:Name="SendTargetPicker" MinWidth="0" MinHeight="28" FontSize="12"
                                VerticalAlignment="Center" />
                      <TextBlock x:Name="SendNoPeersText" Text="还没有已连接的电脑" FontSize="12"
                                 Foreground="{ThemeResource DFMutedBrush}" Visibility="Collapsed"
                                 VerticalAlignment="Center" />
                      <Button x:Name="SendGoAddButton" Content="去添加" Click="SendGoAddClick"
                              Style="{StaticResource DFButtonPlainStyle}" Visibility="Collapsed" Margin="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button x:Name="AddToShelfButton" Content="加入暂存区" Click="AddStagedToShelfClick"
                              Style="{StaticResource DFButtonSecondaryStyle}" Visibility="Collapsed" Margin="0"
                              MinHeight="28" FontSize="12" />
                      <Button x:Name="SendStagedButton" Content="发送" Click="SendStagedClick"
                              Style="{StaticResource DFButtonPrimaryStyle}" IsEnabled="False" Margin="0" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </ScrollViewer>

        <Border Grid.Column="1" Width="1" Background="{ThemeResource DFLineBrush}" />

        <ScrollViewer x:Name="TransfersSideColumn" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16" Spacing="8">
            <TextBlock Text="传输任务" FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource DFMutedBrush}" Margin="4,0,0,0" />
            <Border Style="{StaticResource CardBorder}">
              <Grid>
                <StackPanel x:Name="TransferEmptyState" Spacing="12" HorizontalAlignment="Center" Margin="0,12">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE898;" FontSize="32" Foreground="{ThemeResource DFMutedBrush}" />
                    <FontIcon Glyph="&#xE896;" FontSize="32" Foreground="{ThemeResource DFMutedBrush}" />
                  </StackPanel>
                  <TextBlock Text="还没有传输任务" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="选择文件并发送后，进度会显示在这里。" FontSize="12"
                             Foreground="{ThemeResource DFMutedBrush}" TextAlignment="Center" TextWrapping="Wrap"
                             MaxWidth="360" />
                  <Button Content="选择文件发送" Click="PickFilesClick" Style="{StaticResource DFButtonPrimaryStyle}"
                          HorizontalAlignment="Center" Margin="0" />
                </StackPanel>
                <StackPanel x:Name="TransferList" Spacing="0" Visibility="Collapsed" />
              </Grid>
            </Border>
            <TextBlock x:Name="TransferSummary" FontSize="12" Foreground="{ThemeResource DFMutedBrush}"
                       Margin="4,0" Text="在另一台电脑粘贴文件时会自动开始传输，也可以从暂存区立即发送。"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Workflows (hosted inside settings; hidden from the workspace) -->
      <Grid x:Name="WorkflowsPage" Visibility="Collapsed" Margin="24,12,24,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Margin="0,0,20,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12" Spacing="6">
            <TextBlock Text="工作流" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="管理内容处理步骤和工作流快捷键" FontSize="12"
                       Foreground="{ThemeResource DFMutedBrush}" />
            <Button Content="新建流程" Click="NewWorkflowClick" Style="{StaticResource DFButtonSecondaryStyle}"
                    HorizontalAlignment="Left" Margin="0,6,0,0" />
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="WorkflowList" SelectionChanged="WorkflowSelectionChanged" Background="Transparent"
                      BorderThickness="0">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="10,8" />
                  <Setter Property="Margin" Value="0,1" />
                  <Setter Property="CornerRadius" Value="8" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" />
                    <TextBlock Text="{Binding SummaryLabel}" FontSize="11"
                               Foreground="{ThemeResource DFMutedBrush}" />
                    <TextBlock Text="{Binding ShortcutLabel}" FontSize="11"
                               Foreground="{ThemeResource DFMutedBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Border>
          <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="8">
            <TextBlock x:Name="WorkflowSyncStatus" FontSize="12"
                       Foreground="{ThemeResource DFMutedBrush}" Text="正在读取同步状态…"
                       TextWrapping="Wrap" />
            <StackPanel x:Name="WorkflowConflictList" Spacing="6" />
            <Button Content="刷新同步状态" Click="RefreshWorkflowCatalogClick"
                    Style="{StaticResource DFButtonSecondaryStyle}" HorizontalAlignment="Left" />
            <TextBlock x:Name="WorkflowRunsHeader" Text="最近运行" FontSize="12" FontWeight="SemiBold"
                       Foreground="{ThemeResource DFMutedBrush}" Visibility="Collapsed" />
            <StackPanel x:Name="WorkflowRunsPanel" Spacing="6" />
          </StackPanel>
        </Grid>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="WorkflowEditor" Spacing="10">
              <TextBlock Text="选择或新建工作流" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="中间结果不会写入剪贴板；图片步骤只处理剪贴板中的图片。"
                         FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
              <TextBlock Text="名称" FontWeight="SemiBold" />
              <TextBox x:Name="WorkflowName" />
              <TextBlock Text="接受内容" FontWeight="SemiBold" />
              <ComboBox x:Name="WorkflowInputType" MinWidth="180" HorizontalAlignment="Left"
                        SelectionChanged="WorkflowInputTypeChanged">
                <ComboBoxItem Content="任意内容" Tag="Any" />
                <ComboBoxItem Content="文字" Tag="Text" />
                <ComboBoxItem Content="图片" Tag="Image" />
              </ComboBox>
              <CheckBox x:Name="WorkflowEnabled" Content="启用本机快捷键" />
              <TextBlock Text="快捷键（key code, modifiers；留空表示无快捷键）" FontWeight="SemiBold" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WorkflowShortcut" PlaceholderText="例如 49,1835008" />
                <Button x:Name="WorkflowShortcutRecord" Grid.Column="1" Content="录制…"
                        Click="RecordWorkflowShortcutClick" Style="{StaticResource DFButtonSecondaryStyle}" />
              </Grid>
              <TextBlock Text="依次处理" FontWeight="SemiBold" />
              <StackPanel x:Name="WorkflowStepList" Spacing="8" />
              <Button x:Name="AddWorkflowStepButton" Content="添加动作" HorizontalAlignment="Left"
                      Style="{StaticResource DFButtonSecondaryStyle}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Text="文字替换" Tag="TextReplace" Click="AddWorkflowStepClick" />
                    <MenuFlyoutItem Text="去除首尾空白" Tag="TextTrim" Click="AddWorkflowStepClick" />
                    <MenuFlyoutItem Text="压缩图片" Tag="Compress" Click="AddWorkflowStepClick" />
                    <MenuFlyoutItem Text="调整尺寸" Tag="Resize" Click="AddWorkflowStepClick" />
                    <MenuFlyoutItem Text="转换格式" Tag="Convert" Click="AddWorkflowStepClick" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <TextBlock x:Name="WorkflowCompatibility" FontSize="12"
                         Foreground="{ThemeResource DFWarningBrush}" TextWrapping="Wrap"
                         Visibility="Collapsed" />
              <TextBlock Text="步骤由服务端校验；文件重命名、ZIP 与 macOS 快捷指令在 Windows 上不可用。"
                         FontSize="12" Foreground="{ThemeResource DFMutedBrush}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveWorkflowButton" Content="保存" Click="SaveWorkflowClick"
                        Style="{StaticResource DFButtonPrimaryStyle}" />
                <Button x:Name="RunWorkflowButton" Content="运行" Click="RunWorkflowClick"
                        Style="{StaticResource DFButtonSecondaryStyle}" IsEnabled="False"
                        ToolTipService.ToolTip="按服务端已保存的定义执行；修改后请先保存。" />
                <Button x:Name="DeleteWorkflowButton" Content="删除" Click="DeleteWorkflowClick"
                        Style="{StaticResource DFButtonSecondaryStyle}" />
              </StackPanel>
              <TextBlock x:Name="WorkflowNotice" FontSize="12" Foreground="{ThemeResource DFMutedBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- Remote applications -->
      <Grid x:Name="RemoteApplicationsPage" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Margin="20,18,20,12" Spacing="5">
            <TextBlock Text="设备列表" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="选择设备，打开远端应用" FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
          </StackPanel>
          <Border Grid.Row="1" Margin="20,0,20,10" Height="32" CornerRadius="8"
                  Background="{ThemeResource DFControlBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE721;" FontSize="13" Margin="10,0,8,0" VerticalAlignment="Center"
                        Foreground="{ThemeResource DFMutedBrush}" />
              <TextBox x:Name="RemoteDeviceSearch" Grid.Column="1" PlaceholderText="搜索设备名称、IP 地址…"
                       BorderThickness="0" Background="Transparent" Padding="0,0,8,0" VerticalAlignment="Center"
                       TextChanged="RemoteDeviceSearchChanged" />
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="2" Padding="8,0,8,16">
            <StackPanel x:Name="RemoteDevicesList" Spacing="1" />
          </ScrollViewer>
        </Grid>
        <Border Grid.Column="1" Background="{ThemeResource DFCanvasBrush}">
          <Grid x:Name="RemoteApplicationsHost" />
        </Border>
        <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="{ThemeResource DFLineBrush}" />
      </Grid>

      <!-- Microphone -->
      <ScrollViewer x:Name="MicrophonePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" Spacing="24" MaxWidth="880" HorizontalAlignment="Center">
          <StackPanel Spacing="6">
            <TextBlock Text="麦克风共享 · 即将支持" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Windows 端尚未开放麦克风共享。"
                       FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
          </StackPanel>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" MinHeight="196" Padding="24">
              <StackPanel Spacing="10">
                <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource DFAccentSubtleBrush}">
                  <FontIcon Glyph="&#xE720;" FontSize="22" Foreground="{ThemeResource DFAccentBrush}" />
                </Border>
                <TextBlock Text="我提供麦克风" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="把这台电脑连接的麦克风分享给已配对的电脑。可信设备可直接使用，不需要逐台授权。"
                           FontSize="12" Foreground="{ThemeResource DFMutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="无需逐台授权" FontSize="11" Foreground="{ThemeResource DFSuccessBrush}" />
                <Button Content="选择此身份" IsEnabled="False" Style="{StaticResource DFButtonSecondaryStyle}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" MinHeight="196" Padding="24">
              <StackPanel Spacing="10">
                <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource DFControlBrush}">
                  <FontIcon Glyph="&#xE7F6;" FontSize="22" Foreground="{ThemeResource DFMutedBrush}" />
                </Border>
                <TextBlock Text="我使用其他设备的麦克风" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="使用另一台电脑的麦克风，在本机听写、通话或录音。"
                           FontSize="12" Foreground="{ThemeResource DFMutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="需要安装虚拟麦克风驱动" FontSize="11" Foreground="{ThemeResource DFWarningBrush}" />
                <Button Content="选择此身份" IsEnabled="False" Style="{StaticResource DFButtonSecondaryStyle}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Background="{ThemeResource DFControlBrush}" CornerRadius="8" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource DFAccentBrush}" />
              <TextBlock Text="麦克风共享即将在 Windows 上提供。完成配对后即可在这里选择音源。"
                         FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Mouse buttons -->
      <ScrollViewer x:Name="MouseButtonsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20,24,24" ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="340" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="16">
            <Border Style="{StaticResource CardBorder}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="56" CornerRadius="10" Background="{ThemeResource DFControlBrush}">
                  <FontIcon Glyph="&#xE8B1;" FontSize="26" Foreground="{ThemeResource DFMutedBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="4">
                  <TextBlock Text="鼠标" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="鼠标自定义即将支持；跨屏共享请前往键鼠共享页面" FontSize="12"
                             Foreground="{ThemeResource DFMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border x:Name="MouseSharingPill" Background="{ThemeResource DFSuccessSubtleBrush}" CornerRadius="12"
                          Padding="8,3" Visibility="Collapsed" ToolTipService.ToolTip="键鼠共享已开启，这台电脑的鼠标正在作为主控">
                    <TextBlock Text="主控鼠标生效中" FontSize="11" Foreground="{ThemeResource DFSuccessBrush}" />
                  </Border>
                  <Border Background="{ThemeResource DFControlBrush}" CornerRadius="12"
                          Padding="8,3">
                    <TextBlock Text="即将支持" FontSize="11" Foreground="{ThemeResource DFMutedBrush}" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel Spacing="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="按键分配" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="即将支持" FontSize="11"
                             Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="MouseBindingList" Spacing="0" />
                <TextBlock Text="支持标准 5 键映射；侧键自定义与 Logitech 型号适配将在后续版本提供。"
                           FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="16">
            <Border Style="{StaticResource CardBorder}">
              <StackPanel Spacing="10">
                <TextBlock Text="已支持鼠标" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Windows 版本暂未适配具体型号。" FontSize="12"
                           Foreground="{ThemeResource DFMutedBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel Spacing="10">
                <TextBlock Text="没有找到你的鼠标？" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="记录型号和按键编号，生成 Markdown 数据；后续可直接用于适配。"
                           FontSize="12" Foreground="{ThemeResource DFMutedBrush}" />
                <Button Content="我要提供鼠标数据…" IsEnabled="False"
                        Style="{StaticResource DFButtonSecondaryStyle}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Floating notice (macOS ErrorNoticeView): bottom-right, 380 max. -->
    <Border x:Name="NoticeHost" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
            Margin="0,0,24,24" MaxWidth="380" Background="{ThemeResource DFSurfaceBrush}"
            BorderBrush="{ThemeResource DFWarningBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12"
            Visibility="Collapsed">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource DFWarningBrush}"
                  VerticalAlignment="Top" Margin="0,2,0,0" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="提示" FontSize="13" FontWeight="SemiBold" />
          <TextBlock x:Name="Notice" FontSize="12" Foreground="{ThemeResource DFMutedBrush}"
                     TextWrapping="Wrap" IsTextSelectionEnabled="True" MaxLines="6" />
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource DFIconButtonStyle}" Click="DismissNoticeClick"
                VerticalAlignment="Top">
          <FontIcon Glyph="&#xE711;" FontSize="11" />
        </Button>
      </Grid>
    </Border>

    <!-- First-run onboarding covers the workspace until completed. -->
    <Grid x:Name="OnboardingOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed"
          Background="{ThemeResource DFCanvasBrush}">
      <Grid x:Name="OnboardingHost" />
    </Grid>
  </Grid>
</Window>
