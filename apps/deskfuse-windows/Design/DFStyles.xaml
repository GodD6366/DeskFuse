<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shared surfaces. CardBorder keeps its legacy key because every existing
       page references it; the visuals now follow the macOS card (surface fill,
       hairline border, 12 radius). -->
  <Style x:Key="CardBorder" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource DFSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DFLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DFRadiusCard}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="DividerBorder" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource DFLineBrush}" />
    <Setter Property="Margin" Value="0,16" />
  </Style>

  <!-- Secondary control surface (segmented tracks, wells, hover fills). -->
  <Style x:Key="DFControlSurface" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource DFControlBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource DFRadiusControl}" />
  </Style>

  <!-- Buttons: primary mirrors dfPrimary (accent fill, white label); secondary
       mirrors dfSecondary (surface fill, hairline border). -->
  <Style x:Key="DFButtonPrimaryStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource DFControlHeight}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="{StaticResource DFRadiusControl}" />
  </Style>

  <Style x:Key="DFButtonSecondaryStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="{StaticResource DFControlHeight}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{ThemeResource DFControlBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DFBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DFRadiusControl}" />
  </Style>

  <Style x:Key="DFButtonPlainStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="{StaticResource DFCompactHeight}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource DFAccentBrush}" />
  </Style>

  <!-- Sidebar navigation row: 32pt touch target, 8 radius, accent selection. -->
  <Style x:Key="DFSidebarRowStyle" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="{StaticResource DFRowHeight}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource DFRadiusControl}" />
  </Style>

  <!-- Settings row metric baseline. -->
  <Style x:Key="DFSettingRowStyle" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="{StaticResource DFRowHeight}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="{StaticResource DFRadiusControl}" />
  </Style>
</ResourceDictionary>
