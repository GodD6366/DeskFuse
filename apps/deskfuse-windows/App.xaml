<Application
  x:Class="DeskFuse.Windows.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Native Fluent visuals: surfaces, text colors and control styles follow
           the Windows theme resources, so light/dark mode and the accent color
           match the OS instead of a hand-rolled palette. -->

      <!-- Typography ramp (native Fluent type sizes). -->
      <x:Double x:Key="DisplayFontSize">28</x:Double>
      <x:Double x:Key="TitleFontSize">20</x:Double>
      <x:Double x:Key="SubtitleFontSize">16</x:Double>
      <x:Double x:Key="BodyFontSize">14</x:Double>
      <x:Double x:Key="CaptionFontSize">12</x:Double>

      <!-- Card container used by every page section. -->
      <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
      </Style>

      <!-- Section divider. -->
      <Style x:Key="DividerBorder" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Margin" Value="0,16" />
      </Style>

      <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <!-- Buttons keep the stock Fluent template; only comfortable metrics. -->
      <Style TargetType="Button">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0,0,8,8" />
      </Style>

      <Style TargetType="TextBox">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>

      <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Margin" Value="0,0,8,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>

      <Style TargetType="CheckBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
