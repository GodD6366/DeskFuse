<Application
  x:Class="DeskFuse.Windows.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="Design/DFColors.xaml" />
        <ResourceDictionary Source="Design/DFMetrics.xaml" />
        <ResourceDictionary Source="Design/DFType.xaml" />
        <ResourceDictionary Source="Design/DFStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Design tokens live in Design/DF*.xaml, mirrored from the macOS
           DFTokens design system. Light/dark surfaces, text colors and control
           visuals resolve through DF* brushes so both themes stay coherent. -->

      <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <!-- Buttons keep the stock Fluent template; only comfortable metrics. -->
      <Style TargetType="Button">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0,0,8,8" />
      </Style>

      <Style TargetType="TextBox">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>

      <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Margin" Value="0,0,8,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>

      <Style TargetType="CheckBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
