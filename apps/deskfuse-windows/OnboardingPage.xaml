<UserControl
  x:Class="DeskFuse.Windows.OnboardingPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- First-run onboarding mirrored from the macOS OnboardingFlow: a 264-wide
       step rail on the left, step content on the right, footer navigation.
       The skeleton lives in XAML; step bodies are built in code, matching the
       settings page pattern that is known to load reliably. -->
  <Grid Background="{ThemeResource DFCanvasBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Margin="28,32,24,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <FontIcon Glyph="&#xE8A7;" FontSize="24" Foreground="{ThemeResource DFAccentBrush}" />
        <TextBlock Text="DeskFuse" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="2,32,0,0" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Ellipse x:Name="Step1Dot" Width="8" Height="8" Fill="{ThemeResource DFAccentBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="Step1Title" Text="1  运行环境" Style="{StaticResource DFBodyTextStyle}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Ellipse x:Name="Step2Dot" Width="8" Height="8" Fill="{ThemeResource DFControlStrongBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="Step2Title" Text="2  功能确认" Style="{StaticResource DFBodyTextStyle}" Foreground="{ThemeResource DFMutedBrush}" />
        </StackPanel>
      </StackPanel>
      <TextBlock Grid.Row="2" Text="你的数据只在设备之间传输；剪贴板正文与设备信任材料不会被上传。" Style="{StaticResource DFCaptionTextStyle}" Foreground="{ThemeResource DFMutedBrush}" />
    </Grid>

    <Grid Grid.Column="1" Margin="24,32,28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ContentControl x:Name="StepHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
        <Button x:Name="BackButton" Content="上一步" Click="BackClick" Visibility="Collapsed" />
        <Button x:Name="NextButton" Content="下一步" Click="NextClick" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
