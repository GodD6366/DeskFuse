<UserControl
  x:Class="DeskFuse.Windows.OnboardingPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- First-run onboarding mirrored from the macOS OnboardingFlow: a 264 pt
       step rail, a 52 pt breadcrumb row, a centered 880 pt content column and
       a 64 pt footer. Card bodies are built in code. -->
  <Grid Background="{ThemeResource DFCanvasBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="20,0,16,0">
        <Button Style="{StaticResource DFTrafficLightStyle}" Click="CloseLightClick"
                PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" ToolTipService.ToolTip="关闭"
                AutomationProperties.Name="关闭" AutomationProperties.AutomationId="traffic-close">
          <Grid Width="12" Height="12">
            <Ellipse Fill="#FF5F57" />
            <TextBlock Text="&#x2715;" FontSize="8" Foreground="#FF7A0000" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
        </Button>
        <Button Style="{StaticResource DFTrafficLightStyle}" Click="MinimizeLightClick"
                PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" ToolTipService.ToolTip="最小化"
                AutomationProperties.Name="最小化" AutomationProperties.AutomationId="traffic-minimize">
          <Grid Width="12" Height="12">
            <Ellipse Fill="#FEBC2E" />
            <TextBlock Text="&#x2212;" FontSize="9" Foreground="#FF6A4B00" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
        </Button>
        <Button Style="{StaticResource DFTrafficLightStyle}" Click="MaximizeLightClick"
                PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" ToolTipService.ToolTip="最大化"
                AutomationProperties.Name="最大化" AutomationProperties.AutomationId="traffic-maximize">
          <Grid Width="12" Height="12">
            <Ellipse Fill="#28C840" />
            <TextBlock Text="&#x271A;" FontSize="8" Foreground="#FF0B4A16" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0,0,0">
          <Grid Width="22" Height="22">
            <FontIcon Glyph="&#xE8A7;" FontSize="22" Foreground="{ThemeResource DFAccentBrush}" />
            <Image Source="ms-appx:///Assets/Square44x44Logo.png" Stretch="Uniform" />
          </Grid>
          <TextBlock Text="DeskFuse" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <TextBlock Grid.Row="1" Text="初次设置" FontSize="11" FontWeight="SemiBold"
                 Foreground="{ThemeResource DFMutedBrush}" Margin="24,24,24,12" />
      <StackPanel x:Name="StepList" Grid.Row="2" Margin="24,0,24,0" Spacing="16" />
      <Border Grid.Row="4" Margin="24" Padding="12" CornerRadius="12"
              Background="{ThemeResource DFControlBrush}">
        <StackPanel Spacing="8">
          <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{ThemeResource DFAccentBrush}"
                    HorizontalAlignment="Left" />
          <TextBlock Text="隐私优先" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Text="访问只在本机使用。DeskFuse 不会上传你的剪贴板内容、屏幕画面或音频。"
                     FontSize="12" Foreground="{ThemeResource DFMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Width="1" HorizontalAlignment="Right" Background="{ThemeResource DFLineBrush}" />
    </Grid>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
        <RowDefinition Height="64" />
      </Grid.RowDefinitions>

      <Grid Padding="24,0,24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="初次设置" FontSize="13" Foreground="{ThemeResource DFMutedBrush}" />
          <TextBlock Text="/" FontSize="13" Foreground="{ThemeResource DFMutedBrush}" />
          <TextBlock x:Name="StepTitle" Text="系统权限" FontSize="13" FontWeight="Medium" />
        </StackPanel>
        <TextBlock x:Name="StepCount" Grid.Column="1" Text="第 1 步，共 2 步" FontSize="12"
                   Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center" />
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <Grid>
          <StackPanel x:Name="StepContent" MaxWidth="880" HorizontalAlignment="Stretch"
                      Margin="24,16,24,24" Spacing="24" />
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" BorderBrush="{ThemeResource DFLineBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="24,0,24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="FooterHint" Text="可以稍后授权，功能页会再次提示" FontSize="12"
                     Foreground="{ThemeResource DFMutedBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="BackButton" Content="上一步" Click="BackClick"
                    Style="{StaticResource DFButtonSecondaryStyle}" Visibility="Collapsed" />
            <Button x:Name="NextButton" Content="下一步：选择功能" Click="NextClick"
                    Style="{StaticResource DFButtonPrimaryStyle}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
