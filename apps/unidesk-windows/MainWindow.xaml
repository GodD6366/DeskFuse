<Window x:Class="UniDesk.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="uniDesk" Width="1200" Height="780" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="20,8,12,0">
   <TextBlock Text="uniDesk" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="暂存区" Click="ShelfClick"/><Button Content="设置" Click="SettingsClick"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#EDF4FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
    <DockPanel Margin="12,22,12,16">
     <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="LocalName" FontWeight="SemiBold" Text="这台 Windows"/><TextBlock x:Name="LocalStatus" Foreground="{StaticResource MutedBrush}" Text="正在连接服务…" Margin="0,6,0,0" FontSize="12"/></StackPanel>
     <StackPanel><TextBlock Text="工作空间" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,14"/>
      <ListBox x:Name="Navigation" SelectionChanged="NavigationChanged" SelectedIndex="0"><ListBoxItem Content="▣  剪贴板"/><ListBoxItem Content="⌨  键鼠共享"/><ListBoxItem Content="▱  设备"/><ListBoxItem Content="⇄  传输"/></ListBox>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1">
    <Grid x:Name="ClipboardPage">
     <Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="240" MaxWidth="320"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel Grid.Column="0" Margin="20,18,12,12">
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="剪贴板" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="在设备之间，接着用" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18"/>
       <TextBox x:Name="HistorySearch" ToolTip="搜索剪贴板内容 (Ctrl+F)" TextChanged="HistoryFilterChanged"/>
       <ComboBox x:Name="KindFilter" SelectedIndex="0" SelectionChanged="HistoryFilterChanged"><ComboBoxItem Content="全部内容"/><ComboBoxItem Content="文字"/><ComboBoxItem Content="图片"/><ComboBoxItem Content="文件"/></ComboBox>
       <ComboBox x:Name="SourceFilter" SelectionChanged="HistoryFilterChanged" ToolTip="按来源设备筛选"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><CheckBox x:Name="SyncCheck" Content="同步文字与图片" Checked="SyncChanged" Unchecked="SyncChanged"/><TextBlock x:Name="SyncStatus" Text="等待服务状态" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
      <Grid><ListBox x:Name="HistoryList" SelectionChanged="HistorySelectionChanged" MouseDoubleClick="HistoryDoubleClick"><ListBox.ContextMenu><ContextMenu><MenuItem Header="删除记录" Click="DeleteHistoryClick"/></ContextMenu></ListBox.ContextMenu><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding SourceName}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="HistoryEmpty" Text="还没有剪贴板记录。&#x0a;复制文字、图片或本机文件开始使用。" Margin="12,30" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/></Grid>
     </DockPanel>
     <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}"/>
     <DockPanel Grid.Column="2" Margin="26,22,26,18">
      <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="PreviewTitle" Text="选择一条剪贴板记录" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PreviewMetadata" Text="选择仅预览；点击复制才恢复系统剪贴板。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><WrapPanel><Button x:Name="CopyButton" Content="复制" Style="{StaticResource PrimaryButton}" Click="CopyClick" IsEnabled="False"/><Button x:Name="AddShelfButton" Content="加入暂存区" Click="AddShelfClick" IsEnabled="False"/><Button x:Name="RevealButton" Content="在资源管理器中显示" Click="RevealClick" Visibility="Collapsed"/><Button x:Name="FitButton" Content="适合窗口 / 填满" Click="FitClick" Visibility="Collapsed"/></WrapPanel><TextBlock x:Name="FormatMetadata" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel>
      <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16" ClipToBounds="True"><Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="TextPreview" Text="内容将在这里显示" FontFamily="Segoe UI" FontSize="16"/></ScrollViewer><Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"/></Grid></Border>
     </DockPanel>
    </Grid>
    <Grid x:Name="DevicesPage" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel Margin="22,20,18,16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="设备" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="发现并管理附近设备" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16"/><TextBox x:Name="DeviceSearch" ToolTip="搜索设备" TextChanged="DeviceSearchChanged"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,12"/><TextBlock Text="通过 IPv4 添加设备" FontWeight="SemiBold"/><TextBlock Text="只定位对端；仍需接收方确认配对。" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/><TextBox x:Name="ManualIp" ToolTip="例如 192.168.1.23"/><Button x:Name="PairIpButton" Content="定位并邀请配对" Click="PairIpClick"/></StackPanel>
      <ListBox x:Name="DevicesList" SelectionChanged="DeviceSelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Group}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </DockPanel>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DeviceDetails" Margin="28,24,28,24"/></ScrollViewer>
    </Grid>
    <Grid x:Name="InputPage" Visibility="Collapsed" Margin="24">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="让操作自然跨过屏幕" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="真实显示器布局 · 不把开关当成可用性" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,22"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
      <Border Background="#EDF2F7" CornerRadius="12" Margin="0,0,20,0"><Grid><Canvas x:Name="DisplayCanvas" ClipToBounds="True" SizeChanged="DisplayCanvasSizeChanged"/><TextBlock Text="本机显示器（物理像素）；只读布局，跨设备输入尚不可用。" VerticalAlignment="Bottom" Margin="20" Foreground="{StaticResource MutedBrush}"/></Grid></Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Windows 输入状态" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="InputAvailability" Text="正在连接普通桌面输入 helper…" Margin="0,18,0,20" TextWrapping="Wrap"/><CheckBox x:Name="InputReceiverReady" Content="允许已授权主控控制当前普通桌面" IsEnabled="False"/><Button x:Name="ReclaimInputButton" Content="停止被控并收回本机输入" Click="ReclaimInputClick" IsEnabled="False" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock Text="当前阶段支持已解锁普通桌面；管理员窗口、登录与 UAC 安全桌面仍保持不可用。紧急收回：Ctrl + Alt + Win + Esc。" Margin="0,20,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="TransfersPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24"><TextBlock Text="传输" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="文件在目标设备粘贴时传输，也可以从暂存区立即发送。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,28"/><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="28"><StackPanel><TextBlock Text="跨设备文件传输尚未接入" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="此版本可记录本机文件引用、暂存并拖出已存在的本机文件；不会把本地路径冒充远端已下载文件。" Margin="0,14,0,10"/><TextBlock Text="远端按需下载、Explorer/OLE 延迟渲染、完整性与缓存配额接入前，不显示虚构传输任务或成功进度。" Foreground="{StaticResource MutedBrush}"/><Button Content="打开本地暂存区" Click="ShelfClick" HorizontalAlignment="Left" Margin="0,22,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#EAF1F8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,8"><TextBlock x:Name="Notice" Text="正在连接 UniDeskService…" FontSize="12" TextWrapping="Wrap"/></Border>
 </Grid>
</Window>
