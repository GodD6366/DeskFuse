<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinUI 3 (Windows App SDK) desktop client. This project is the migration
    target for apps/deskfuse-windows (WPF); both exist until the port is
    complete, and package/store scripts select the client with -ClientProject.
    AssemblyName stays DeskFuse.Windows so packaging, MSIX manifests and the
    NSIS payload layout keep working unchanged.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinUI 3 needs the Windows 10 19041 projections; the runtime minimum stays
         17763 (Windows 10 1809) through TargetPlatformMinVersion. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DeskFuse.Windows</RootNamespace>
    <AssemblyName>DeskFuse.Windows</AssemblyName>
    <Platforms>x64</Platforms>
    <!-- Self-contained Windows App SDK deployment needs a concrete RID. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The packaged/Store build must not carry the uiAccess manifest; the same
         file is used by the MSIX layout and app.store.manifest in the sibling
         WPF project, so identity stays single-sourced. -->
    <ApplicationManifest>..\deskfuse-windows\app.store.manifest</ApplicationManifest>
    <ApplicationIcon>..\deskfuse-windows\Assets\DeskFuse.ico</ApplicationIcon>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- SessionSwitch notifications for clipboard pause/resume and the desktop
         data types the client already used through the WindowsDesktop SDK. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\deskfuse-windows\Assets\DeskFuse.ico" Link="Assets\DeskFuse.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\deskfuse-windows\Assets\*.png" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
