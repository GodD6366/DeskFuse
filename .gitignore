# One dependency graph for the application workspace.
**/target/
**/Cargo.lock
!/Cargo.lock

# Local builds, screenshots, logs, source snapshots and device evidence.
/dist/
/artifacts/
*.dmg
*.app/
__pycache__/
*.pyc

# Read-only Finder diagnostics used for local validation; not part of the
# documented build or release pipeline.
/scripts/probe-finder-applescript.sh
/scripts/probe-finder-directory.py

# Generated artwork is rebuilt from the committed SVG sources.
/resources/generated/
/resources/macos_center_icon.svg

# Keep legacy design directories out of Git; maintained designs live in design/current.
/design/atelier/
/design/proposals/
/design/iterations/
/design/current/archive/
/design/BLUESYNC_DESIGN.md

# Local agent installation and machine-specific configuration.
.agents/
/.codex/
/AGENTS.md
/CLAUDE.md
.antigravitycli/
/node
/skills-lock.json
.env
.env.*
!.env.example
.DS_Store
*.p12
*.p8
*.pfx
*.keychain-db

# Local device identity secret.
identity.key

# Machine-specific signing certificate fingerprint (no private key).
.codesign-identity

# Reproducible generated native bindings and Swift build artifacts.
/apps/deskfuse-macos/.build/
/apps/deskfuse-macos/.build-fast/
/apps/deskfuse-macos/.swiftpm/
/apps/deskfuse-macos/Generated/
/apps/deskfuse-macos/Sources/DeskFuseEngine/*.swift
/apps/deskfuse-macos/Sources/DeskFuseEngineFFI/*.h
/apps/deskfuse-macos/Sources/DeskFuseEngineFFI/module.modulemap
/apps/deskfuse-macos/SDK/*.a
/apps/deskfuse-macos/SDK/*.h
/apps/deskfuse-macos/SDK/*.modulemap
/apps/deskfuse-macos/SDK/deskfuse-input-macos
/apps/deskfuse-macos/SDK/manifest.json

# Go WebView client: npm install output and the Vite bundle embedded by go:embed.
/apps/deskfuse-go/frontend/node_modules/
/apps/deskfuse-go/frontend/dist/
/apps/deskfuse-go/frontend/public/deskfuse-icon.png
/apps/deskfuse-go/frontend/public/deskfuse-icon-light.png
/apps/deskfuse-macos/SDK/.rust-fingerprint
/apps/deskfuse-macos/SDK/.rust-fingerprint-*
/apps/deskfuse-macos/SDK/.swift-fingerprint-*
/apps/deskfuse-macos/SDK/.swift-bin-path-*
/apps/deskfuse-macos/SDK/.helpers-fingerprint-*
/apps/deskfuse-macos/SDK/.swift-bindings-fingerprint.json

# Historical development plans remain local; active contracts stay in docs/.
/docs/INPUT_DATAGRAM_PLAN.md
/docs/NATIVE_MIGRATION.md
/docs/archive/
/docs/history/

# FreeRDP static library bundle (regenerate with scripts/build-freerdp-macos.sh).
/apps/deskfuse-macos/RemoteApplication/Vendor/

# Windows native desktop build outputs.
/apps/deskfuse-windows/bin/
/apps/deskfuse-windows/obj/
/tools/DeskFuse.HistoryChecks/bin/
/tools/DeskFuse.HistoryChecks/obj/
/tools/DeskFuse.InputLayoutChecks/bin/
/tools/DeskFuse.InputLayoutChecks/obj/

# Website dependencies and Pages build output (web/ → /site).
/web/node_modules/
/site/
