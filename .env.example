# Copy to a gitignored .env for local Developer ID / notarization.
# GitHub Releases read the same names from Actions secrets. How to mint
# each value: docs/NOTARIZE.md

# Base64 of the exported Developer ID Application .p12
APPLE_DEVELOPER_ID_P12=
APPLE_DEVELOPER_ID_P12_PASSWORD=

# 10-character Team ID from developer.apple.com → Membership details
APPLE_TEAM_ID=

# Preferred notarytool credentials: base64 of AuthKey_*.p8, plus Key ID / Issuer
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# Fallback if an App Store Connect API key is unavailable
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=

# Optional. After import-developer-id.sh, CI writes the certificate SHA-1 here.
# Locally you can set the full name: Developer ID Application: Name (TEAMID)
# CODESIGN_IDENTITY=

# Set to 1 on the public release job so packaging fails closed without notarization.
# DESKFUSE_REQUIRE_NOTARIZE=1
